@prefix : <http://www.uoc.edu/emdco#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.uoc.edu/emdco#> .

<http://www.uoc.edu/emdco> rdf:type owl:Ontology ;
                            <http://purl.org/dc/elements/1.1/creator> "Roger Batlle Duran" ;
                            <http://purl.org/dc/elements/1.1/date> "2026-04-22" ;
                            <http://purl.org/dc/elements/1.1/description> "Ontology for the classification and management of medical devices according to European regulations MDR (EU 2017/745) and IVDR (EU 2017/746). Enables semantic interoperability between manufacturers, regulatory authorities, hospitals and patients."@en ;
                            <http://purl.org/dc/elements/1.1/publisher> "Universitat Oberta de Catalunya (UOC)" ;
                            <http://purl.org/dc/elements/1.1/subject> "Medical Devices, MDR, IVDR, Risk Classification, EUDAMED, FSCA"@en ;
                            <http://purl.org/dc/elements/1.1/title> "European Medical Device Risk Classification Ontology (EMDCO)"@en ;
                            rdfs:comment "This ontology models medical devices, manufacturers, risk classifications, incidents and corrective actions (FSCA) according to EU MDR/IVDR regulations. Supports vigilance, post-market surveillance and interoperability with EUDAMED."@en ;
                            rdfs:label "EMDCO - European Medical Device Risk Classification Ontology"@en ;
                            rdfs:seeAlso <https://eudamed.ec.europa.eu> ;
                            owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
<http://purl.org/dc/elements/1.1/date> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/publisher
<http://purl.org/dc/elements/1.1/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/subject
<http://purl.org/dc/elements/1.1/subject> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.uoc.edu/emdco#hasCorrectiveAction
:hasCorrectiveAction rdf:type owl:ObjectProperty ;
                     rdfs:domain :Incident ;
                     rdfs:range :CorrectiveAction ;
                     rdfs:comment "Corrective actions (FSCA) taken in response to an incident."@en ;
                     rdfs:label "has corrective action"@en .


###  http://www.uoc.edu/emdco#hasIncident
:hasIncident rdf:type owl:ObjectProperty ;
             rdfs:domain :Device ;
             rdfs:range :Incident ;
             rdfs:comment "An incident reported for a specific device under post-market vigilance."@en ;
             rdfs:label "has incident"@en .


###  http://www.uoc.edu/emdco#hasManufacturer
:hasManufacturer rdf:type owl:ObjectProperty ;
                 rdfs:domain :Device ;
                 rdfs:range :Manufacturer ;
                 rdfs:comment "Relationship between a medical device and its manufacturer (responsible entity under MDR)."@en ;
                 rdfs:label "has manufacturer"@en .


###  http://www.uoc.edu/emdco#hasProbability
:hasProbability rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Risk ;
                rdfs:range :Probability ;
                rdfs:comment "Probability level of a risk."@en ;
                rdfs:label "has probability"@en .


###  http://www.uoc.edu/emdco#hasRisk
:hasRisk rdf:type owl:ObjectProperty ;
         rdfs:domain :Incident ;
         rdfs:range :Risk ;
         rdfs:comment "The identified risk(s) associated with an incident."@en ;
         rdfs:label "has risk"@en .


###  http://www.uoc.edu/emdco#hasRiskClass
:hasRiskClass rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Device ;
              rdfs:range :RiskClass ;
              rdfs:comment "Regulatory risk classification of the device according to MDR Annex VIII."@en ;
              rdfs:label "has risk class"@en .


###  http://www.uoc.edu/emdco#hasSeverity
:hasSeverity rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Risk ;
             rdfs:range :Severity ;
             rdfs:comment "Severity level of a risk."@en ;
             rdfs:label "has severity"@en .


###  http://www.uoc.edu/emdco#manufacturedIn
:manufacturedIn rdf:type owl:ObjectProperty ;
                rdfs:domain :Manufacturer ;
                rdfs:range :Country ;
                rdfs:comment "The country where a manufacturer is headquartered."@en ;
                rdfs:label "manufactured in"@en .


###  http://www.uoc.edu/emdco#reportedInCountry
:reportedInCountry rdf:type owl:ObjectProperty ;
                   rdfs:domain :Incident ;
                   rdfs:range :Country ;
                   rdfs:comment "The country where an incident was reported to competent authorities."@en ;
                   rdfs:label "reported in country"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.uoc.edu/emdco#actionDate
:actionDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :CorrectiveAction ;
            rdfs:range xsd:date ;
            rdfs:comment "Date when the corrective action was initiated (YYYY-MM-DD)."@en ;
            rdfs:label "action date"@en .


###  http://www.uoc.edu/emdco#deviceName
:deviceName rdf:type owl:DatatypeProperty ;
            rdfs:domain :Device ;
            rdfs:range xsd:string ;
            rdfs:comment "The commercial name of the medical device as registered in EUDAMED."@en ;
            rdfs:label "device name"@en .


###  http://www.uoc.edu/emdco#devicesAffected
:devicesAffected rdf:type owl:DatatypeProperty ;
                 rdfs:domain :CorrectiveAction ;
                 rdfs:range xsd:integer ;
                 rdfs:comment "Number of devices affected by the corrective action."@en ;
                 rdfs:label "devices affected"@en .


###  http://www.uoc.edu/emdco#eudamedSRN
:eudamedSRN rdf:type owl:DatatypeProperty ;
            rdfs:domain :Manufacturer ;
            rdfs:range xsd:string ;
            rdfs:comment "Single Registration Number assigned by EUDAMED (MDR Art. 31)."@en ;
            rdfs:label "EUDAMED SRN"@en .


###  http://www.uoc.edu/emdco#incidentDescription
:incidentDescription rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Incident ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Detailed narrative description of the incident and its circumstances."@en ;
                     rdfs:label "incident description"@en .


###  http://www.uoc.edu/emdco#isActive
:isActive rdf:type owl:DatatypeProperty ;
          rdfs:domain :Device ;
          rdfs:range xsd:boolean ;
          rdfs:comment "Boolean indicating if the device is active (requires power source)."@en ;
          rdfs:label "is active"@en .


###  http://www.uoc.edu/emdco#isImplantable
:isImplantable rdf:type owl:DatatypeProperty ;
               rdfs:domain :Device ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Boolean indicating if the device is implantable in the human body."@en ;
               rdfs:label "is implantable"@en .


###  http://www.uoc.edu/emdco#manufacturerName
:manufacturerName rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Manufacturer ;
                  rdfs:range xsd:string ;
                  rdfs:comment "The official legal name of the manufacturer as registered in EUDAMED."@en ;
                  rdfs:label "manufacturer name"@en .


###  http://www.uoc.edu/emdco#patientAge
:patientAge rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:integer ;
            rdfs:comment "Age of the patient involved in the incident (in years)."@en ;
            rdfs:label "patient age"@en .


###  http://www.uoc.edu/emdco#reportDate
:reportDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:date ;
            rdfs:comment "Date when the incident was reported to the competent authority (YYYY-MM-DD)."@en ;
            rdfs:label "report date"@en .


###  http://www.uoc.edu/emdco#requiresEnhancedSurveillance
:requiresEnhancedSurveillance rdf:type owl:DatatypeProperty ;
                              rdfs:domain :Device ;
                              rdfs:range xsd:boolean ;
                              rdfs:comment "Inferred by SWRL Rule 2: ClassIII devices with incidents require enhanced post-market surveillance."@en ;
                              rdfs:label "requires enhanced surveillance"@en .


###  http://www.uoc.edu/emdco#requiresEscalation
:requiresEscalation rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Incident ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Inferred by SWRL Rule 3: incidents with active safety alerts require escalation to vigilance committee."@en ;
                    rdfs:label "requires escalation"@en .


###  http://www.uoc.edu/emdco#requiresImmediateAlert
:requiresImmediateAlert rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Device ;
                        rdfs:range xsd:boolean ;
                        rdfs:comment "Inferred by SWRL Rule 1: device with critical risk incidents requires immediate regulatory alert."@en ;
                        rdfs:label "requires immediate alert"@en .


###  http://www.uoc.edu/emdco#riskName
:riskName rdf:type owl:DatatypeProperty ;
          rdfs:domain :Risk ;
          rdfs:range xsd:string ;
          rdfs:comment "Name of the identified risk according to IMDRF Adverse Event Terminology."@en ;
          rdfs:label "risk name"@en .


###  http://www.uoc.edu/emdco#udiDI
:udiDI rdf:type owl:DatatypeProperty ;
       rdfs:domain :Device ;
       rdfs:range xsd:string ;
       rdfs:comment "Unique Device Identifier - Device Identifier as required by MDR Art. 27."@en ;
       rdfs:label "UDI-DI"@en .


#################################################################
#    Classes
#################################################################

###  http://www.uoc.edu/emdco#ActiveDevice
:ActiveDevice rdf:type owl:Class ;
              rdfs:subClassOf :Device ;
              rdfs:comment "A medical device that depends on a source of electrical energy or any source of power other than that directly generated by the human body or gravity."@en ;
              rdfs:label "Active Medical Device"@en .


###  http://www.uoc.edu/emdco#ActiveImplant
:ActiveImplant rdf:type owl:Class ;
               rdfs:subClassOf :ImplantableDevice ;
               rdfs:comment "An implantable device that requires a power source (e.g., pacemaker, LVAD, cochlear implant)."@en ;
               rdfs:label "Active Implantable Device"@en .


###  http://www.uoc.edu/emdco#BiomaterialRisk
:BiomaterialRisk rdf:type owl:Class ;
                 rdfs:subClassOf :Risk ;
                 rdfs:comment "Risk related to biomaterial interactions (thrombosis, infection, biocompatibility, allergic reactions)."@en ;
                 rdfs:label "Biomaterial Risk"@en .


###  http://www.uoc.edu/emdco#ClassI
:ClassI rdf:type owl:Class ;
        rdfs:subClassOf :RiskClass ;
        rdfs:comment "Lowest risk class. Self-certification by the manufacturer is sufficient (e.g., bandages, wheelchairs)."@en ;
        rdfs:label "Risk Class I"@en .


###  http://www.uoc.edu/emdco#ClassIII
:ClassIII rdf:type owl:Class ;
          rdfs:subClassOf :RiskClass ;
          rdfs:comment "Highest risk class. Requires rigorous Notified Body assessment (e.g., heart valves, pacemakers, LVAD)."@en ;
          rdfs:label "Risk Class III"@en .


###  http://www.uoc.edu/emdco#ClassIIa
:ClassIIa rdf:type owl:Class ;
          rdfs:subClassOf :RiskClass ;
          rdfs:comment "Low to medium risk. Requires Notified Body assessment (e.g., hearing aids, contact lenses)."@en ;
          rdfs:label "Risk Class IIa"@en .


###  http://www.uoc.edu/emdco#ClassIIb
:ClassIIb rdf:type owl:Class ;
          rdfs:subClassOf :RiskClass ;
          rdfs:comment "Medium to high risk. Requires Notified Body assessment (e.g., ventilators, surgical lasers, infusion pumps)."@en ;
          rdfs:label "Risk Class IIb"@en .


###  http://www.uoc.edu/emdco#CorrectiveAction
:CorrectiveAction rdf:type owl:Class ;
                  rdfs:comment "Any corrective action taken by the manufacturer for technical or medical reasons related to device characteristics (MDR Art. 2.68)."@en ;
                  rdfs:label "Field Safety Corrective Action (FSCA)"@en .


###  http://www.uoc.edu/emdco#Country
:Country rdf:type owl:Class ;
         rdfs:comment "A country where a manufacturer is based or where an incident is reported. Typically an EU Member State."@en ;
         rdfs:label "Country"@en .


###  http://www.uoc.edu/emdco#Device
:Device rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :hasManufacturer ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Manufacturer
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasRiskClass ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :RiskClass
                        ] .


###  http://www.uoc.edu/emdco#DeviceFailureRisk
:DeviceFailureRisk rdf:type owl:Class ;
                   rdfs:subClassOf :Risk ;
                   rdfs:comment "Risk related to failure of device components (electrical, mechanical, software, battery)."@en ;
                   rdfs:label "Device Failure Risk"@en .


###  http://www.uoc.edu/emdco#ExternalDevice
:ExternalDevice rdf:type owl:Class ;
                rdfs:subClassOf :ActiveDevice ;
                rdfs:comment "An active medical device used externally to the body (e.g., infusion pump, external defibrillator)."@en ;
                rdfs:label "External Active Device"@en .


###  http://www.uoc.edu/emdco#FieldCorrection
:FieldCorrection rdf:type owl:Class ;
                 rdfs:subClassOf :CorrectiveAction ;
                 rdfs:comment "Correction performed in the field without removing the device (e.g., software update, labeling change)."@en ;
                 rdfs:label "Field Correction"@en .


###  http://www.uoc.edu/emdco#IVDDevice
:IVDDevice rdf:type owl:Class ;
           rdfs:subClassOf :Device ;
           rdfs:comment "A medical device used for the in vitro examination of specimens according to IVDR Regulation (EU) 2017/746."@en ;
           rdfs:label "In Vitro Diagnostic Device"@en .


###  http://www.uoc.edu/emdco#ImplantableDevice
:ImplantableDevice rdf:type owl:Class ;
                   rdfs:subClassOf :ActiveDevice ;
                   rdfs:comment "A medical device intended to be introduced wholly or partially into the human body through surgical intervention and to remain in place after the procedure."@en ;
                   rdfs:label "Implantable Medical Device"@en .


###  http://www.uoc.edu/emdco#Incident
:Incident rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasRisk ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Risk
                          ] ;
          rdfs:comment "An adverse event related to a medical device that is reportable under MDR/IVDR vigilance (Art. 87)."@en ;
          rdfs:label "Incident"@en .


###  http://www.uoc.edu/emdco#MalfunctionRisk
:MalfunctionRisk rdf:type owl:Class ;
                 rdfs:subClassOf :Risk ;
                 rdfs:comment "Risk of device malfunction during operation (software errors, performance degradation)."@en ;
                 rdfs:label "Malfunction Risk"@en .


###  http://www.uoc.edu/emdco#Manufacturer
:Manufacturer rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :manufacturedIn ;
                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Country
                              ] ;
              rdfs:comment "An entity that manufactures medical devices and is responsible for their design, production and marketing under MDR/IVDR regulations. Must be registered in EUDAMED with a SRN."@en ;
              rdfs:label "Manufacturer"@en ;
              rdfs:seeAlso <http://dbpedia.org/resource/Manufacturer> .


###  http://www.uoc.edu/emdco#NonSeriousIncident
:NonSeriousIncident rdf:type owl:Class ;
                    rdfs:subClassOf :Incident ;
                    rdfs:comment "An incident that did not lead to serious consequences but must be reported for trending analysis."@en ;
                    rdfs:label "Non-Serious Incident"@en .


###  http://www.uoc.edu/emdco#PassiveDevice
:PassiveDevice rdf:type owl:Class ;
               rdfs:subClassOf :Device ;
               rdfs:comment "A medical device that does not require a source of electrical energy or other power source (e.g., bandages, surgical instruments)."@en ;
               rdfs:label "Passive Medical Device"@en .


###  http://www.uoc.edu/emdco#Probability
:Probability rdf:type owl:Class ;
             rdfs:comment "Probability level of a risk occurrence (ISO 14971)."@en ;
             rdfs:label "Probability"@en .


###  http://www.uoc.edu/emdco#Recall
:Recall rdf:type owl:Class ;
        rdfs:subClassOf :CorrectiveAction ;
        rdfs:comment "Removal of a device from the market due to safety concerns."@en ;
        rdfs:label "Recall"@en .


###  http://www.uoc.edu/emdco#Risk
:Risk rdf:type owl:Class ;
      rdfs:comment "A potential hazard associated with the use of a medical device, classified according to IMDRF nomenclature."@en ;
      rdfs:label "Risk"@en .


###  http://www.uoc.edu/emdco#RiskClass
:RiskClass rdf:type owl:Class ;
           rdfs:comment "Regulatory risk classification for medical devices according to MDR Annex VIII (Classes I, IIa, IIb, III)."@en ;
           rdfs:label "Risk Classification"@en .


###  http://www.uoc.edu/emdco#SafetyAlert
:SafetyAlert rdf:type owl:Class ;
             rdfs:subClassOf :CorrectiveAction ;
             rdfs:comment "A field safety notice (FSN) issued to alert users about a device safety issue without requiring removal."@en ;
             rdfs:label "Safety Alert"@en .


###  http://www.uoc.edu/emdco#SeriousIncident
:SeriousIncident rdf:type owl:Class ;
                 rdfs:subClassOf :Incident ;
                 rdfs:comment "An incident that led or might have led to death or serious deterioration of health. Must be reported within 15 days."@en ;
                 rdfs:label "Serious Incident"@en .


###  http://www.uoc.edu/emdco#Severity
:Severity rdf:type owl:Class ;
          rdfs:comment "Severity level of a risk (ISO 14971)."@en ;
          rdfs:label "Severity"@en .


#################################################################
#    Individuals
#################################################################

###  http://dbpedia.org/resource/Germany
<http://dbpedia.org/resource/Germany> rdf:type owl:NamedIndividual ;
                                      owl:sameAs :Germany .


###  http://www.uoc.edu/emdco#Germany

###  http://dbpedia.org/resource/Ireland
<http://dbpedia.org/resource/Ireland> rdf:type owl:NamedIndividual ;
                                      owl:sameAs :Ireland .


###  http://www.uoc.edu/emdco#Ireland

###  http://dbpedia.org/resource/Medical_device
<http://dbpedia.org/resource/Medical_device> rdf:type owl:NamedIndividual ;
                                             owl:sameAs :Device .


###  http://www.uoc.edu/emdco#Device
:Device rdf:type owl:NamedIndividual .


###  http://dbpedia.org/resource/Medtronic
<http://dbpedia.org/resource/Medtronic> rdf:type owl:NamedIndividual ;
                                        owl:sameAs :MAN_001_Medtronic .


###  http://www.uoc.edu/emdco#MAN_001_Medtronic

###  http://www.uoc.edu/emdco#ClassIII_Instance
:ClassIII_Instance rdf:type owl:NamedIndividual ,
                            :ClassIII ;
                   rdfs:comment "Highest risk classification under MDR (EU 2017/745) Annex VIII."@en ;
                   rdfs:label "Class III - Highest Risk"@en .


###  http://www.uoc.edu/emdco#Critical_Instance
:Critical_Instance rdf:type owl:NamedIndividual ,
                            :Severity ;
                   rdfs:comment "Critical severity - can cause death or serious permanent injury (ISO 14971)."@en ;
                   rdfs:label "Critical"@en .


###  http://www.uoc.edu/emdco#DEV_001_HeartMate3
:DEV_001_HeartMate3 rdf:type owl:NamedIndividual ,
                             :ActiveImplant ;
                    :hasIncident :INC_001 ;
                    :hasManufacturer :MAN_001_Medtronic ;
                    :hasRiskClass :ClassIII_Instance ;
                    :deviceName "HeartMate 3 LVAD" ;
                    :isActive "true"^^xsd:boolean ;
                    :isImplantable "true"^^xsd:boolean ;
                    :udiDI "(01)00380740009095" ;
                    rdfs:comment "Left Ventricular Assist Device for end-stage heart failure patients."@en ;
                    rdfs:label "HeartMate 3 LVAD"@en .


###  http://www.uoc.edu/emdco#Device
:Device rdf:type owl:NamedIndividual .


###  http://www.uoc.edu/emdco#FSCA_001_SafetyAlert
:FSCA_001_SafetyAlert rdf:type owl:NamedIndividual ,
                               :SafetyAlert ;
                      :actionDate "2024-02-01"^^xsd:date ;
                      :devicesAffected 850 ;
                      rdfs:comment "Safety alert issued to all implanting centres regarding anticoagulation protocol update."@en ;
                      rdfs:label "FSCA-001 Safety Alert"@en .


###  http://www.uoc.edu/emdco#Germany
:Germany rdf:type owl:NamedIndividual ,
                  :Country ;
         rdfs:comment "Federal Republic of Germany - EU Member State."@en ;
         rdfs:label "Germany"@en .


###  http://www.uoc.edu/emdco#INC_001
:INC_001 rdf:type owl:NamedIndividual ,
                  :SeriousIncident ;
         :hasCorrectiveAction :FSCA_001_SafetyAlert ;
         :hasRisk :RSK_003_Thrombosis ;
         :reportedInCountry :Germany ;
         :incidentDescription "Patient with HeartMate 3 LVAD developed ischemic stroke. Device thrombus confirmed by echocardiography." ;
         :patientAge 58 ;
         :reportDate "2024-01-15"^^xsd:date ;
         rdfs:comment "Patient implanted with HeartMate 3 LVAD developed ischemic stroke 6 months post-implant."@en ;
         rdfs:label "Incident INC-001 (HeartMate 3 thrombosis)"@en .


###  http://www.uoc.edu/emdco#Ireland
:Ireland rdf:type owl:NamedIndividual ,
                  :Country ;
         rdfs:comment "Republic of Ireland - EU Member State."@en ;
         rdfs:label "Ireland"@en .


###  http://www.uoc.edu/emdco#Low_Instance
:Low_Instance rdf:type owl:NamedIndividual ,
                       :Probability ;
              rdfs:comment "Low probability of occurrence (ISO 14971)."@en ;
              rdfs:label "Low"@en .


###  http://www.uoc.edu/emdco#MAN_001_Medtronic
:MAN_001_Medtronic rdf:type owl:NamedIndividual ,
                            :Manufacturer ;
                   :manufacturedIn :Ireland ;
                   :eudamedSRN "SRN-IE-MED-0001" ;
                   :manufacturerName "Medtronic plc" ;
                   rdfs:comment "Medtronic plc - Irish medical device multinational corporation."@en ;
                   rdfs:label "Medtronic plc"@en .


###  http://www.uoc.edu/emdco#RSK_003_Thrombosis
:RSK_003_Thrombosis rdf:type owl:NamedIndividual ,
                             :BiomaterialRisk ;
                    :hasProbability :Low_Instance ;
                    :hasSeverity :Critical_Instance ;
                    :riskName "Device Thrombosis" ;
                    rdfs:comment "Blood clot formation within the device (IMDRF code: B0303)."@en ;
                    rdfs:label "Device Thrombosis"@en .


#################################################################
#    Annotations
#################################################################

:Device rdfs:comment "A medical device intended for diagnosis, treatment, monitoring or prevention of disease according to MDR Regulation (EU) 2017/745."@en ;
        rdfs:label "Medical Device"@en ;
        rdfs:seeAlso <http://dbpedia.org/resource/Medical_device> .


#################################################################
#    Rules
#################################################################

<urn:swrl#d> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<urn:swrl#inc> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<urn:swrl#r> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<urn:swrl#i> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<urn:swrl#fsca> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ rdfs:comment "If a ClassIII device has any reported incident, it requires enhanced post-market surveillance."@en ;
   rdfs:label "Rule 2: Enhanced Surveillance for Class III"@en ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Device ;
