<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.uoc.edu/emdco#"
     xml:base="http://www.uoc.edu/emdco"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="http://www.uoc.edu/emdco">
        <owl:versionIRI rdf:resource="http://www.uoc.edu/emdco/1.0"/>
        <ns:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <dc:creator>Roger Batlle Duran</dc:creator>
        <dc:date>2026-04-22</dc:date>
        <dc:description xml:lang="en">Ontology for the classification and management of medical devices according to European regulations MDR (EU 2017/745) and IVDR (EU 2017/746). Enables semantic interoperability between manufacturers, regulatory authorities, hospitals and patients.</dc:description>
        <dc:language>en</dc:language>
        <dc:publisher>Universitat Oberta de Catalunya (UOC)</dc:publisher>
        <dc:rights>Creative Commons Attribution 4.0 International (CC BY 4.0)</dc:rights>
        <dc:subject xml:lang="en">Medical Devices, MDR, IVDR, Risk Classification, EUDAMED, FSCA</dc:subject>
        <dc:title xml:lang="en">European Medical Device Risk Classification Ontology (EMDCO)</dc:title>
        <terms:bibliographicCitation>Batlle Duran, R. (2026). European Medical Device Risk Classification Ontology (EMDCO) v1.0. Universitat Oberta de Catalunya.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-22</terms:created>
        <terms:creator>Roger Batlle Duran</terms:creator>
        <terms:description xml:lang="en">Ontology for the classification and management of medical devices according to European regulations MDR (EU 2017/745) and IVDR (EU 2017/746). Enables semantic interoperability between manufacturers, regulatory authorities, hospitals and patients.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-27</terms:issued>
        <terms:language>en</terms:language>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-27</terms:modified>
        <terms:publisher>Universitat Oberta de Catalunya (UOC)</terms:publisher>
        <terms:rights>Creative Commons Attribution 4.0 International (CC BY 4.0)</terms:rights>
        <terms:subject xml:lang="en">Medical Devices, MDR, IVDR, Risk Classification, EUDAMED, FSCA</terms:subject>
        <terms:title xml:lang="en">European Medical Device Risk Classification Ontology (EMDCO)</terms:title>
        <bibo:status>http://purl.org/ontology/bibo/status/published</bibo:status>
        <vann:preferredNamespacePrefix>emdco</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://www.uoc.edu/emdco#</vann:preferredNamespaceUri>
        <schema:creator>Roger Batlle Duran</schema:creator>
        <schema:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <schema:publisher>Universitat Oberta de Catalunya (UOC)</schema:publisher>
        <schema:schemaVersion>1.0</schema:schemaVersion>
        <rdfs:comment xml:lang="en">This ontology models medical devices, manufacturers, risk classifications, incidents and corrective actions (FSCA) according to EU MDR/IVDR regulations.</rdfs:comment>
        <rdfs:label xml:lang="en">EMDCO - European Medical Device Risk Classification Ontology</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://eudamed.ec.europa.eu"/>
        <rdfs:seeAlso rdf:resource="https://www.imdrf.org/"/>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    


