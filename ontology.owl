<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.uoc.edu/emdco#"
     xml:base="http://www.uoc.edu/emdco"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:emdco="http://www.uoc.edu/emdco#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://www.uoc.edu/emdco">
        <dc:creator>Roger Batlle Duran</dc:creator>
        <dc:date>2026-04-22</dc:date>
        <dc:description xml:lang="en">Ontology for the classification and management of medical devices according to European regulations MDR (EU 2017/745) and IVDR (EU 2017/746). Enables semantic interoperability between manufacturers, regulatory authorities, hospitals and patients.</dc:description>
        <dc:publisher>Universitat Oberta de Catalunya (UOC)</dc:publisher>
        <dc:subject xml:lang="en">Medical Devices, MDR, IVDR, Risk Classification, EUDAMED, FSCA</dc:subject>
        <dc:title xml:lang="en">European Medical Device Risk Classification Ontology (EMDCO)</dc:title>
        <rdfs:comment xml:lang="en">This ontology models medical devices, manufacturers, risk classifications, incidents and corrective actions (FSCA) according to EU MDR/IVDR regulations. Supports vigilance, post-market surveillance and interoperability with EUDAMED.</rdfs:comment>
        <rdfs:label xml:lang="en">EMDCO - European Medical Device Risk Classification Ontology</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://eudamed.ec.europa.eu"/>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/publisher"/>
    


    <!-- http://purl.org/dc/elements/1.1/subject -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/subject"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.uoc.edu/emdco#hasCorrectiveAction -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasCorrectiveAction">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#CorrectiveAction"/>
        <rdfs:comment xml:lang="en">Corrective actions (FSCA) taken in response to an incident.</rdfs:comment>
        <rdfs:label xml:lang="en">has corrective action</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#hasIncident -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasIncident">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:comment xml:lang="en">An incident reported for a specific device under post-market vigilance.</rdfs:comment>
        <rdfs:label xml:lang="en">has incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#hasManufacturer -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasManufacturer">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Manufacturer"/>
        <rdfs:comment xml:lang="en">Relationship between a medical device and its manufacturer (responsible entity under MDR).</rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#hasProbability -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasProbability">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Risk"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Probability"/>
        <rdfs:comment xml:lang="en">Probability level of a risk.</rdfs:comment>
        <rdfs:label xml:lang="en">has probability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#hasRisk -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasRisk">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Risk"/>
        <rdfs:comment xml:lang="en">The identified risk(s) associated with an incident.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#hasRiskClass -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasRiskClass">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#RiskClass"/>
        <rdfs:comment xml:lang="en">Regulatory risk classification of the device according to MDR Annex VIII.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk class</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#hasSeverity -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasSeverity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Risk"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Severity"/>
        <rdfs:comment xml:lang="en">Severity level of a risk.</rdfs:comment>
        <rdfs:label xml:lang="en">has severity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#manufacturedIn -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#manufacturedIn">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Country"/>
        <rdfs:comment xml:lang="en">The country where a manufacturer is headquartered.</rdfs:comment>
        <rdfs:label xml:lang="en">manufactured in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#reportedInCountry -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#reportedInCountry">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Country"/>
        <rdfs:comment xml:lang="en">The country where an incident was reported to competent authorities.</rdfs:comment>
        <rdfs:label xml:lang="en">reported in country</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.uoc.edu/emdco#actionDate -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#actionDate">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date when the corrective action was initiated (YYYY-MM-DD).</rdfs:comment>
        <rdfs:label xml:lang="en">action date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#deviceName -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#deviceName">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The commercial name of the medical device as registered in EUDAMED.</rdfs:comment>
        <rdfs:label xml:lang="en">device name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#devicesAffected -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#devicesAffected">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of devices affected by the corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">devices affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#eudamedSRN -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#eudamedSRN">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Single Registration Number assigned by EUDAMED (MDR Art. 31).</rdfs:comment>
        <rdfs:label xml:lang="en">EUDAMED SRN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#incidentDescription -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#incidentDescription">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Detailed narrative description of the incident and its circumstances.</rdfs:comment>
        <rdfs:label xml:lang="en">incident description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#isActive -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#isActive">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean indicating if the device is active (requires power source).</rdfs:comment>
        <rdfs:label xml:lang="en">is active</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#isImplantable -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#isImplantable">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean indicating if the device is implantable in the human body.</rdfs:comment>
        <rdfs:label xml:lang="en">is implantable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#manufacturerName -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#manufacturerName">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The official legal name of the manufacturer as registered in EUDAMED.</rdfs:comment>
        <rdfs:label xml:lang="en">manufacturer name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#patientAge -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#patientAge">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Age of the patient involved in the incident (in years).</rdfs:comment>
        <rdfs:label xml:lang="en">patient age</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#reportDate -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#reportDate">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date when the incident was reported to the competent authority (YYYY-MM-DD).</rdfs:comment>
        <rdfs:label xml:lang="en">report date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#requiresEnhancedSurveillance -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#requiresEnhancedSurveillance">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Inferred by SWRL Rule 2: ClassIII devices with incidents require enhanced post-market surveillance.</rdfs:comment>
        <rdfs:label xml:lang="en">requires enhanced surveillance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#requiresEscalation -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#requiresEscalation">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Inferred by SWRL Rule 3: incidents with active safety alerts require escalation to vigilance committee.</rdfs:comment>
        <rdfs:label xml:lang="en">requires escalation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#requiresImmediateAlert -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#requiresImmediateAlert">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Inferred by SWRL Rule 1: device with critical risk incidents requires immediate regulatory alert.</rdfs:comment>
        <rdfs:label xml:lang="en">requires immediate alert</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#riskName -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#riskName">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the identified risk according to IMDRF Adverse Event Terminology.</rdfs:comment>
        <rdfs:label xml:lang="en">risk name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#udiDI -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#udiDI">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Unique Device Identifier - Device Identifier as required by MDR Art. 27.</rdfs:comment>
        <rdfs:label xml:lang="en">UDI-DI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.uoc.edu/emdco#ActiveDevice -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:comment xml:lang="en">A medical device that depends on a source of electrical energy or any source of power other than that directly generated by the human body or gravity.</rdfs:comment>
        <rdfs:label xml:lang="en">Active Medical Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#ActiveImplant -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ActiveImplant">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#ImplantableDevice"/>
        <rdfs:comment xml:lang="en">An implantable device that requires a power source (e.g., pacemaker, LVAD, cochlear implant).</rdfs:comment>
        <rdfs:label xml:lang="en">Active Implantable Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#BiomaterialRisk -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#BiomaterialRisk">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to biomaterial interactions (thrombosis, infection, biocompatibility, allergic reactions).</rdfs:comment>
        <rdfs:label xml:lang="en">Biomaterial Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#ClassI -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ClassI">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#RiskClass"/>
        <rdfs:comment xml:lang="en">Lowest risk class. Self-certification by the manufacturer is sufficient (e.g., bandages, wheelchairs).</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Class I</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#ClassIII -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ClassIII">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#RiskClass"/>
        <rdfs:comment xml:lang="en">Highest risk class. Requires rigorous Notified Body assessment (e.g., heart valves, pacemakers, LVAD).</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Class III</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#ClassIIa -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ClassIIa">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#RiskClass"/>
        <rdfs:comment xml:lang="en">Low to medium risk. Requires Notified Body assessment (e.g., hearing aids, contact lenses).</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Class IIa</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#ClassIIb -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ClassIIb">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#RiskClass"/>
        <rdfs:comment xml:lang="en">Medium to high risk. Requires Notified Body assessment (e.g., ventilators, surgical lasers, infusion pumps).</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Class IIb</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#CorrectiveAction -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#CorrectiveAction">
        <rdfs:comment xml:lang="en">Any corrective action taken by the manufacturer for technical or medical reasons related to device characteristics (MDR Art. 2.68).</rdfs:comment>
        <rdfs:label xml:lang="en">Field Safety Corrective Action (FSCA)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#Country -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#Country">
        <rdfs:comment xml:lang="en">A country where a manufacturer is based or where an incident is reported. Typically an EU Member State.</rdfs:comment>
        <rdfs:label xml:lang="en">Country</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#Device -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#Device">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.uoc.edu/emdco#hasManufacturer"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.uoc.edu/emdco#Manufacturer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.uoc.edu/emdco#hasRiskClass"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.uoc.edu/emdco#RiskClass"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#DeviceFailureRisk -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#DeviceFailureRisk">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to failure of device components (electrical, mechanical, software, battery).</rdfs:comment>
        <rdfs:label xml:lang="en">Device Failure Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#ExternalDevice -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ExternalDevice">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#ActiveDevice"/>
        <rdfs:comment xml:lang="en">An active medical device used externally to the body (e.g., infusion pump, external defibrillator).</rdfs:comment>
        <rdfs:label xml:lang="en">External Active Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#FieldCorrection -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#FieldCorrection">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#CorrectiveAction"/>
        <rdfs:comment xml:lang="en">Correction performed in the field without removing the device (e.g., software update, labeling change).</rdfs:comment>
        <rdfs:label xml:lang="en">Field Correction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#IVDDevice -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#IVDDevice">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:comment xml:lang="en">A medical device used for the in vitro examination of specimens according to IVDR Regulation (EU) 2017/746.</rdfs:comment>
        <rdfs:label xml:lang="en">In Vitro Diagnostic Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#ImplantableDevice -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ImplantableDevice">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#ActiveDevice"/>
        <rdfs:comment xml:lang="en">A medical device intended to be introduced wholly or partially into the human body through surgical intervention and to remain in place after the procedure.</rdfs:comment>
        <rdfs:label xml:lang="en">Implantable Medical Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#Incident -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#Incident">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.uoc.edu/emdco#hasRisk"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.uoc.edu/emdco#Risk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An adverse event related to a medical device that is reportable under MDR/IVDR vigilance (Art. 87).</rdfs:comment>
        <rdfs:label xml:lang="en">Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#MalfunctionRisk -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#MalfunctionRisk">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#Risk"/>
        <rdfs:comment xml:lang="en">Risk of device malfunction during operation (software errors, performance degradation).</rdfs:comment>
        <rdfs:label xml:lang="en">Malfunction Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#Manufacturer -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#Manufacturer">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.uoc.edu/emdco#manufacturedIn"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.uoc.edu/emdco#Country"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An entity that manufactures medical devices and is responsible for their design, production and marketing under MDR/IVDR regulations. Must be registered in EUDAMED with a SRN.</rdfs:comment>
        <rdfs:label xml:lang="en">Manufacturer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Manufacturer"/>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#NonSeriousIncident -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#NonSeriousIncident">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:comment xml:lang="en">An incident that did not lead to serious consequences but must be reported for trending analysis.</rdfs:comment>
        <rdfs:label xml:lang="en">Non-Serious Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#PassiveDevice -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#PassiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:comment xml:lang="en">A medical device that does not require a source of electrical energy or other power source (e.g., bandages, surgical instruments).</rdfs:comment>
        <rdfs:label xml:lang="en">Passive Medical Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#Probability -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#Probability">
        <rdfs:comment xml:lang="en">Probability level of a risk occurrence (ISO 14971).</rdfs:comment>
        <rdfs:label xml:lang="en">Probability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#Recall -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#Recall">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#CorrectiveAction"/>
        <rdfs:comment xml:lang="en">Removal of a device from the market due to safety concerns.</rdfs:comment>
        <rdfs:label xml:lang="en">Recall</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#Risk -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#Risk">
        <rdfs:comment xml:lang="en">A potential hazard associated with the use of a medical device, classified according to IMDRF nomenclature.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#RiskClass -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#RiskClass">
        <rdfs:comment xml:lang="en">Regulatory risk classification for medical devices according to MDR Annex VIII (Classes I, IIa, IIb, III).</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Classification</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#SafetyAlert -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#SafetyAlert">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#CorrectiveAction"/>
        <rdfs:comment xml:lang="en">A field safety notice (FSN) issued to alert users about a device safety issue without requiring removal.</rdfs:comment>
        <rdfs:label xml:lang="en">Safety Alert</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#SeriousIncident -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#SeriousIncident">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:comment xml:lang="en">An incident that led or might have led to death or serious deterioration of health. Must be reported within 15 days.</rdfs:comment>
        <rdfs:label xml:lang="en">Serious Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#Severity -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#Severity">
        <rdfs:comment xml:lang="en">Severity level of a risk (ISO 14971).</rdfs:comment>
        <rdfs:label xml:lang="en">Severity</rdfs:label>
    </owl:Class>
    


