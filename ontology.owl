    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.uoc.edu/emdco#hasCorrectiveAction -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasCorrectiveAction">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#CorrectiveAction"/>
        <rdfs:comment xml:lang="en">Corrective actions taken in response to an incident.</rdfs:comment>
        <rdfs:label xml:lang="en">has corrective action</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#hasIncident -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasIncident">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:comment xml:lang="en">An incident reported for a specific device.</rdfs:comment>
        <rdfs:label xml:lang="en">has incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#hasManufacturer -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasManufacturer">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Manufacturer"/>
        <rdfs:comment xml:lang="en">Relationship between a medical device and its manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#hasProbability -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasProbability">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Risk"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Probability"/>
        <rdfs:comment xml:lang="en">Probability level of a risk.</rdfs:comment>
        <rdfs:label xml:lang="en">has probability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#hasRisk -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasRisk">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Risk"/>
        <rdfs:comment xml:lang="en">The identified risk associated with an incident.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#hasRiskClass -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasRiskClass">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#RiskClass"/>
        <rdfs:comment xml:lang="en">Regulatory risk classification of the device according to MDR Annex VIII.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk class</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#hasSeverity -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#hasSeverity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Risk"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Severity"/>
        <rdfs:comment xml:lang="en">Severity level of a risk.</rdfs:comment>
        <rdfs:label xml:lang="en">has severity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#manufacturedIn -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#manufacturedIn">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Country"/>
        <rdfs:comment xml:lang="en">The country where a manufacturer is headquartered.</rdfs:comment>
        <rdfs:label xml:lang="en">manufactured in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.uoc.edu/emdco#reportedInCountry -->


    <owl:ObjectProperty rdf:about="http://www.uoc.edu/emdco#reportedInCountry">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:range rdf:resource="http://www.uoc.edu/emdco#Country"/>
        <rdfs:comment xml:lang="en">The country where an incident was reported.</rdfs:comment>
        <rdfs:label xml:lang="en">reported in country</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.uoc.edu/emdco#actionDate -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#actionDate">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date when the corrective action was initiated.</rdfs:comment>
        <rdfs:label xml:lang="en">action date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#deviceName -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#deviceName">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The commercial name of the medical device.</rdfs:comment>
        <rdfs:label xml:lang="en">device name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#devicesAffected -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#devicesAffected">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of devices affected by the corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">devices affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#eudamedSRN -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#eudamedSRN">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Single Registration Number assigned by EUDAMED.</rdfs:comment>
        <rdfs:label xml:lang="en">EUDAMED SRN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#incidentDescription -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#incidentDescription">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Detailed description of the incident.</rdfs:comment>
        <rdfs:label xml:lang="en">incident description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#isActive -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#isActive">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean indicating if the device is active.</rdfs:comment>
        <rdfs:label xml:lang="en">is active</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#isImplantable -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#isImplantable">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean indicating if the device is implantable.</rdfs:comment>
        <rdfs:label xml:lang="en">is implantable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#manufacturerName -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#manufacturerName">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The official legal name of the manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">manufacturer name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#patientAge -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#patientAge">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Age of the patient involved in the incident.</rdfs:comment>
        <rdfs:label xml:lang="en">patient age</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#reportDate -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#reportDate">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date when the incident was reported.</rdfs:comment>
        <rdfs:label xml:lang="en">report date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#riskName -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#riskName">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the identified risk.</rdfs:comment>
        <rdfs:label xml:lang="en">risk name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.uoc.edu/emdco#udiDI -->


    <owl:DatatypeProperty rdf:about="http://www.uoc.edu/emdco#udiDI">
        <rdfs:domain rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Unique Device Identifier as required by MDR Art. 27.</rdfs:comment>
        <rdfs:label xml:lang="en">UDI-DI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.uoc.edu/emdco#ActiveDevice -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#Device"/>
        <rdfs:comment xml:lang="en">A medical device that depends on a source of electrical energy or any source of power.</rdfs:comment>
        <rdfs:label xml:lang="en">Active Medical Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#ActiveImplant -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ActiveImplant">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#ImplantableDevice"/>
        <rdfs:comment xml:lang="en">An implantable device that requires a power source (e.g., pacemaker, LVAD).</rdfs:comment>
        <rdfs:label xml:lang="en">Active Implantable Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#BiomaterialRisk -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#BiomaterialRisk">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to biomaterial interactions.</rdfs:comment>
        <rdfs:label xml:lang="en">Biomaterial Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#ClassI -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ClassI">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#RiskClass"/>
        <rdfs:comment xml:lang="en">Lowest risk class. Self-certification by the manufacturer is sufficient.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Class I</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#ClassIII -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ClassIII">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#RiskClass"/>
        <rdfs:comment xml:lang="en">Highest risk class. Requires rigorous Notified Body assessment.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Class III</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#ClassIIa -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ClassIIa">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#RiskClass"/>
        <rdfs:comment xml:lang="en">Low to medium risk. Requires Notified Body assessment.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Class IIa</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#ClassIIb -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#ClassIIb">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#RiskClass"/>
        <rdfs:comment xml:lang="en">Medium to high risk. Requires Notified Body assessment.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Class IIb</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#CorrectiveAction -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#CorrectiveAction">
        <rdfs:comment xml:lang="en">Any corrective action taken by the manufacturer for technical or medical reasons.</rdfs:comment>
        <rdfs:label xml:lang="en">Field Safety Corrective Action</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#Country -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#Country">
        <rdfs:comment xml:lang="en">A country where a manufacturer is based or where an incident is reported.</rdfs:comment>
        <rdfs:label xml:lang="en">Country</rdfs:label>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#Device -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#Device">
        <rdfs:comment xml:lang="en">A medical device intended for diagnosis, treatment, monitoring or prevention of disease according to MDR Regulation (EU) 2017/745.</rdfs:comment>
        <rdfs:label xml:lang="en">Medical Device</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Medical_device"/>
    </owl:Class>
    


    <!-- http://www.uoc.edu/emdco#DeviceFailureRisk -->


    <owl:Class rdf:about="http://www.uoc.edu/emdco#DeviceFailureRisk">
        <rdfs:subClassOf rdf:resource="http://www.uoc.edu/emdco#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to failure of device components.</rdfs:comment>
