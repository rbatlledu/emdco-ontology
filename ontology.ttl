                            <http://purl.org/dc/terms/creator> "Roger Batlle Duran" ;
                            <http://purl.org/dc/terms/description> "Ontology for the classification and management of medical devices according to European regulations MDR (EU 2017/745) and IVDR (EU 2017/746). Enables semantic interoperability between manufacturers, regulatory authorities, hospitals and patients."@en ;
                            <http://purl.org/dc/terms/issued> "2026-04-27"^^xsd:date ;
