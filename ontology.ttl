                            <http://schema.org/schemaVersion> "1.0" ;
                            rdfs:comment "This ontology models medical devices, manufacturers, risk classifications, incidents and corrective actions (FSCA) according to EU MDR/IVDR regulations."@en ;
                            rdfs:label "EMDCO - European Medical Device Risk Classification Ontology"@en ;
                            rdfs:seeAlso <https://eudamed.ec.europa.eu> ,
                                         <https://www.imdrf.org/> ;
