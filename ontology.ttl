                            <http://purl.org/dc/elements/1.1/title> "European Medical Device Risk Classification Ontology (EMDCO)"@en ;
                            <http://purl.org/dc/terms/bibliographicCitation> "Batlle Duran, R. (2026). European Medical Device Risk Classification Ontology (EMDCO) v1.0. Universitat Oberta de Catalunya." ;
