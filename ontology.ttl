                            <http://purl.org/dc/terms/subject> "Medical Devices, MDR, IVDR, Risk Classification, EUDAMED, FSCA"@en ;
                            <http://purl.org/dc/terms/title> "European Medical Device Risk Classification Ontology (EMDCO)"@en ;
                            <http://purl.org/ontology/bibo/status> "http://purl.org/ontology/bibo/status/published" ;
