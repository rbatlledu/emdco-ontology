}, {
  "@id" : "http://purl.org/dc/elements/1.1/description",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://purl.org/dc/elements/1.1/publisher",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://purl.org/dc/elements/1.1/subject",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://purl.org/dc/elements/1.1/title",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://www.uoc.edu/emdco",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "Roger Batlle Duran"
  } ],
  "http://purl.org/dc/elements/1.1/date" : [ {
    "@value" : "2026-04-22"
  } ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@language" : "en",
    "@value" : "Ontology for the classification and management of medical devices according to European regulations MDR (EU 2017/745) and IVDR (EU 2017/746). Enables semantic interoperability between manufacturers, regulatory authorities, hospitals and patients."
  } ],
  "http://purl.org/dc/elements/1.1/publisher" : [ {
    "@value" : "Universitat Oberta de Catalunya (UOC)"
  } ],
  "http://purl.org/dc/elements/1.1/subject" : [ {
    "@language" : "en",
    "@value" : "Medical Devices, MDR, IVDR, Risk Classification, EUDAMED, FSCA"
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "en",
    "@value" : "European Medical Device Risk Classification Ontology (EMDCO)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This ontology models medical devices, manufacturers, risk classifications, incidents and corrective actions (FSCA) according to EU MDR/IVDR regulations. Supports vigilance, post-market surveillance and interoperability with EUDAMED."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EMDCO - European Medical Device Risk Classification Ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://eudamed.ec.europa.eu"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "1.0"
  } ]
}, {
  "@id" : "http://www.uoc.edu/emdco#ActiveDevice",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A medical device that depends on a source of electrical energy or any source of power other than that directly generated by the human body or gravity."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Active Medical Device"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.uoc.edu/emdco#Device"
  } ]
}, {
  "@id" : "http://www.uoc.edu/emdco#ActiveImplant",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An implantable device that requires a power source (e.g., pacemaker, LVAD, cochlear implant)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Active Implantable Device"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.uoc.edu/emdco#ImplantableDevice"
  } ]
}, {
  "@id" : "http://www.uoc.edu/emdco#BiomaterialRisk",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Risk related to biomaterial interactions (thrombosis, infection, biocompatibility, allergic reactions)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Biomaterial Risk"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.uoc.edu/emdco#Risk"
  } ]
}, {
  "@id" : "http://www.uoc.edu/emdco#ClassI",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Lowest risk class. Self-certification by the manufacturer is sufficient (e.g., bandages, wheelchairs)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Risk Class I"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.uoc.edu/emdco#RiskClass"
  } ]
}, {
  "@id" : "http://www.uoc.edu/emdco#ClassIII",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Highest risk class. Requires rigorous Notified Body assessment (e.g., heart valves, pacemakers, LVAD)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Risk Class III"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.uoc.edu/emdco#RiskClass"
  } ]
}, {
  "@id" : "http://www.uoc.edu/emdco#ClassIII_Instance",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.uoc.edu/emdco#ClassIII"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Highest risk classification under MDR (EU 2017/745) Annex VIII."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Class III - Highest Risk"
  } ]
}, {
  "@id" : "http://www.uoc.edu/emdco#ClassIIa",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Low to medium risk. Requires Notified Body assessment (e.g., hearing aids, contact lenses)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Risk Class IIa"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.uoc.edu/emdco#RiskClass"
  } ]
}, {
  "@id" : "http://www.uoc.edu/emdco#ClassIIb",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Medium to high risk. Requires Notified Body assessment (e.g., ventilators, surgical lasers, infusion pumps)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Risk Class IIb"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.uoc.edu/emdco#RiskClass"
  } ]
}, {
  "@id" : "http://www.uoc.edu/emdco#CorrectiveAction",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Any corrective action taken by the manufacturer for technical or medical reasons related to device characteristics (MDR Art. 2.68)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Field Safety Corrective Action (FSCA)"
  } ]
